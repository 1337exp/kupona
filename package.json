{
  "name": "kupona",
  "version": "0.0.0",
  "private": true,
  "description": "Bond or deposit? Put them side by side as a chain of nodes and see what you end up with, step by step.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.core.json && vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@1337exp/taoui": "^5.32.2",
    "@1337exp/taoux": "^0.11.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.65.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
